{
  "name": "ez-signature-extraction",
  "version": "1.1.2",
  "description": "EZ Desktop Signature Preservation and Isolation Engine",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ionic/vue": "^7.0.0",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.4.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "vite-plugin-electron": "^0.11.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^1.6.0"
  },
  "build": {
    "appId": "com.ez.signature.extraction",
    "productName": "EZ Signature Extraction Engine",
    "directories": {
      "output": "exe"
    },
    "win": {
      "target": "dir",
      "cscLink": null,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "extraResources": [
      {
        "from": "backend_dist/ez_backend",
        "to": "backend/ez_backend",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
